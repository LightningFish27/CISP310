; Example assembly language program -- adds 158 to number in memory
; Author:  R. Detmer
; Date:    6/2013

.586
.MODEL FLAT

include io.h            ; header file for input/output

.STACK  4096            ; reserve 4096-byte stack

.DATA
prompt1     BYTE    "Enter a string: ", 0
stringIn    BYTE    80 DUP (?)          ; input string buffer

prompt2     BYTE    "Enter character to find: ", 0
charToFind  BYTE    3 DUP (?)                 ; character to find (room for newline + null)

outputLbl   BYTE    "Character found this many times: ", 0
outputCount BYTE    10 DUP (?)

.CODE                           ; start of main program code
_MainProc    PROC
        input prompt2, charToFind, 3         ; get character to find
        mov BYTE PTR [charToFind + 1], 0     ; null terminate character input to cutoff any extra input

        input prompt1, stringIn, 80          ; get input string from user

        ; push parameters and call charCount
        lea eax, stringIn
        push eax				
        lea eax, charToFind
        push eax                            ; push address of character

        call charCount                      ; call string character count function (result in eax)
        add  esp, 8                         ; clean up stack (2 parameters)

        ; display result
        dtoa outputCount, eax               ; convert count to string
        output outputLbl, outputCount       ; output result

        mov   eax, 0            ; exit with return code 0
        ret
_MainProc    ENDP

charCount PROC
        push ebp
        mov  ebp, esp
        push edi
        push esi
        push ecx
        pushfd                          ; save flags including direction flag
        
        mov esi, [ebp + 8]             ; get address of string  
        mov edi, [ebp + 12]            ; get address of char
        
        ; Get the character to find
        mov al, BYTE PTR [edi]         ; character to search for
        
        ; Get string length first using scasb to find null terminator
        mov edi, esi                   ; point edi to start of string
        mov ecx, -1                    ; set ecx to maximum possible length
        xor al, al                     ; look for null terminator (0)
        cld                            ; clear direction flag (forward scan)
        repne scasb                    ; scan for null terminator
        not ecx                        ; convert to positive length
        dec ecx                        ; subtract 1 (don't count null terminator)
        mov edx, ecx                   ; save string length in edx
        
        ; Now search for the target character
        mov edi, esi                   ; reset edi to start of string
        mov al, BYTE PTR [ebp + 12]    ; reload target character
        mov al, BYTE PTR [edi]         ; get target character from address
        lea edi, [esi]                 ; point edi to string start
        mov edi, [ebp + 12]            ; get char address again
        mov al, BYTE PTR [edi]         ; load the target character
        mov edi, esi                   ; point edi to string
        mov ecx, edx                   ; set count to string length
        xor ebx, ebx                   ; clear match counter
        
        cld                            ; ensure forward direction
        
searchLoop:
        test ecx, ecx                  ; check if we've reached end
        jz searchDone                  ; if ecx is 0, we're done
        
        scasb                          ; compare al with [edi], increment edi
        jne noMatch                    ; if no match, continue
        inc ebx                        ; increment match counter
        
noMatch:
        dec ecx                        ; decrement remaining count
        jmp searchLoop                 ; continue searching
        
searchDone:
        mov eax, ebx                   ; return count in eax
        
        popfd                          ; restore flags
        pop ecx
        pop esi  
        pop edi
        pop ebp
        ret
charCount ENDP
END                             ; end of source code
