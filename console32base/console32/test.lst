				; Example assembly language program -- adds 158 to number in memory
				; Author:  R. Detmer
				; Date:    6/2013

				.586
				.MODEL FLAT

				.STACK  4096            ; reserve 4096-byte stack

 00000000			.DATA                   ; reserve storage for data
 00000000 000001E0		number  DWORD   480
 00000004 00000000		diff    DWORD   ?

 00000000			.CODE                           ; start of main program code
 00000000			main    PROC
 00000000  A1 00000000 R	        mov     eax, number     ; first number to EAX
 00000005  2D 000003E8		        sub     eax, 1000       ; add 74
 0000000A  A3 00000004 R	        mov     diff, eax       ; sum to memory

 0000000F  B8 00000000		        mov   eax, 0            ; exit with return code 0
 00000014  C3			        ret
 00000015			main    ENDP

				END                             ; end of source code
