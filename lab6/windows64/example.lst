	   63 74 69 6F 6E
	   20 78 20 2D 20
	   32 79 20 2B 20
	   34 7A 20 69 73
	   3A 00
 00000076  0000000B [		sum       BYTE    11 DUP(?), 0
	    00
	   ] 00

 00000000			.CODE
 00000000			MainProc  PROC
 00000000  48/ 83 EC 78		          sub     rsp, 120        ; reserve stack space for MainProc

 00000004  B8 00000000		          mov eax, 0                    ; clear EAX

				          input   prompt1, string, 40   ; read ASCII characters
				          atod    string                ; convert to integer
 00000095  89 05 00000000 R	          mov     x, eax                ; store in memory

				          input   prompt2, string, 40   ; read ASCII characters
				          atod    string                ; convert to integer
 00000127  89 05 00000004 R	          mov     y, eax                ; store in memory

				          input   prompt3, string, 40   ; read ASCII characters
				          atod    string                ; convert to integer
 000001B9  89 05 00000008 R	          mov     z, eax                ; store in memory
				        
 000001BF  8B 05 00000000 R	          mov     eax, x                ; Put x in EAX
 000001C5  8B 1D 00000004 R	          mov     ebx, y                ; Put y in EBX
 000001CB  D1 E3		          shl     ebx, 1                ; Multiply y by 2
 000001CD  2B C3		          sub     eax, ebx              ; Subtract 2y from x
 000001CF  8B 1D 00000008 R	          mov     ebx, z                ; Put z in EBX
 000001D5  C1 E3 02		          shl     ebx, 2                ; Multiply z by 4
 000001D8  03 C3		          add     eax, ebx              ; Add 4z to result

				          dtoa    sum, eax              ; convert result to ASCII

				          output  resultLbl, sum  ; output label and sum


