				; Example assembly language program -- adds 158 to number in memory
				; Author:  R. Detmer
				; Date:    6/2013

				.586
				.MODEL FLAT

				.STACK  4096            ; reserve 4096-byte stack

				; Constants
 = 00000004			DWORD_SIZE    EQU 4             ; size of a DWORD in bytes
 = FFFFFFFF			SENTINEL      EQU 0FFFFFFFFh    ; a value larger than any valid array element
 = 00000000			INDEX_INIT    EQU 0             ; 0-indexed arrays

 00000000			.DATA                   ; reserve storage for data

				; Allocate space for 6 DWORDs but initialize only 5 values.
 00000000 00000001		arr1 DWORD 1,3,5,7,9,?      ; Leave last element uninitialized
	   00000003
	   00000005
	   00000007
	   00000009
	   00000000
 00000018 00000005		count1 DWORD 5              ; Size  of first array not counting uninitialized element
 0000001C 00000002		arr2 DWORD 2,4,6,8,10,?     ; Same for second array
	   00000004
	   00000006
	   00000008
	   0000000A
	   00000000
 00000034 00000005		count2 DWORD 5           
 00000038  0000000A [		arr3 DWORD 10 DUP (?)        ; Output array for merged result. Length is sum of arr1_size and arr2_size
	    00000000
	   ]

				; Indexes (initialize to INDEX_INIT)
 00000060 00000000		index1 DWORD INDEX_INIT
 00000064 00000000		index2 DWORD INDEX_INIT
 00000068 00000000		index3 DWORD INDEX_INIT

 00000000			.CODE                           ; start of main program code
 00000000			main    PROC
				        ; Push parameters for arrmerge in reverse order
 00000000  68 00000038 R	        push  OFFSET arr3     ; push pointer to output array
 00000005  FF 35 00000034 R	        push  DWORD PTR [count2] ; push size of second array
 0000000B  68 0000001C R	        push  OFFSET arr2     ; push pointer to second array
 00000010  FF 35 00000018 R	        push  DWORD PTR [count1] ; push size of first array
 00000016  68 00000000 R	        push  OFFSET arr1     ; push pointer to first array

 0000001B  E8 00000009		        call  arrmerge        ; call the merge function
 00000020  83 C4 14		        add   esp, 20         ; clean up the stack (5 parameters * 4 bytes each)
				        ; Note that ebx is the output array pointer.


 00000023  B8 00000000		        mov   eax, 0            ; exit with return code 0
 00000028  C3			        ret
 00000029			main    ENDP

				; Merges two sorted arrays into a single sorted array
				; Takes in 5 parameters:
				; 1. pointer to first array
				; 2. size of first array
				; 3. pointer to second array
				; 4. size of second array
				; 5. pointer to output array
 00000029			arrmerge PROC
 00000029  55			        push ebp
 0000002A  8B EC		        mov  ebp, esp
				        ; Initialize pointers and counters
 0000002C  8B 75 08		        mov  esi, [ebp + 8]      ; pointer to first array
 0000002F  8B 4D 0C		        mov  ecx, [ebp + 12]     ; size of first array
 00000032  8B 7D 10		        mov  edi, [ebp + 16]     ; pointer to second array
 00000035  8B 55 14		        mov  edx, [ebp + 20]     ; size of second array
 00000038  8B 5D 18		        mov  ebx, [ebp + 24]     ; pointer to output array

				        ; Set sentinels after each array: arr[count] = SENTINEL
 0000003B  8B C1		        mov eax, ecx             ; copy count1 to eax
 0000003D  C7 04 86		        mov DWORD PTR [esi + eax*DWORD_SIZE], SENTINEL ; set sentinel in arr1[count]
	   FFFFFFFF
 00000044  8B C2		        mov eax, edx             ; copy count2 to eax
 00000046  C7 04 87		        mov DWORD PTR [edi + eax*DWORD_SIZE], SENTINEL ; set sentinel in arr2[count]
	   FFFFFFFF

 0000004D			merge_loop:
				            ; Compare total length to current output index
 0000004D  8B C1		            mov eax, ecx        ; Set eax to count1(ecx)
 0000004F  03 C2		            add eax, edx        ; add count2(edx)
 00000051  3B 05 00000068 R	            cmp eax, index3     ; compare idx3 to count1+count2
 00000057  7E 59		            jle end_merge_loop

				            ; load index variables into registers
 00000059  A1 00000060 R	            mov  eax, DWORD PTR [index1]                ; eax = idx1
 0000005E  8B 0D 00000064 R	            mov  ecx, DWORD PTR [index2]                ; ecx = idx2
				            ; load elements using regs as scaled indexes
 00000064  8B 04 86		            mov  eax, DWORD PTR [esi + eax*DWORD_SIZE]  ; edx = arr1[idx1]
 00000067  8B 0C 8F		            mov  ecx, DWORD PTR [edi + ecx*DWORD_SIZE]  ; ecx = arr2[idx2]
				            ; now compare registers
 0000006A  3B C1		            cmp  eax, ecx
 0000006C  8B 4D 0C		            mov  ecx, [ebp + 12]     ; reload size of first array since it was just overwritten
 0000006F  7D 22		            jge greater_than

				            ; Copy from first array
 00000071  A1 00000060 R	            mov eax, DWORD PTR [index1]
 00000076  8B 0D 00000068 R	            mov ecx, DWORD PTR [index3]
 0000007C  8B 04 86		            mov eax, DWORD PTR [esi + eax*DWORD_SIZE]   ; load arr1[idx1] into eax
 0000007F  89 04 8B		            mov DWORD PTR [ebx + ecx*DWORD_SIZE], eax   ; store into arr3[idx3]
 00000082  8B 4D 0C		            mov  ecx, [ebp + 12]     ; reload size of first array since it was just overwritten
 00000085  FF 05 00000060 R	            inc index1
 0000008B  FF 05 00000068 R	            inc index3
 00000091  EB BA		            jmp merge_loop

 00000093			greater_than:
				            ; Copy from second array (fixed to use index2)
 00000093  A1 00000064 R	            mov eax, DWORD PTR [index2]
 00000098  8B 0D 00000068 R	            mov ecx, DWORD PTR [index3]
 0000009E  8B 04 87		            mov eax, DWORD PTR [edi + eax*DWORD_SIZE]
 000000A1  89 04 8B		            mov DWORD PTR [ebx + ecx*DWORD_SIZE], eax
 000000A4  FF 05 00000064 R	            inc index2
 000000AA  FF 05 00000068 R	            inc index3
 000000B0  EB 9B		            jmp merge_loop

 000000B2			end_merge_loop:

 000000B2  8B E5		        mov esp, ebp
 000000B4  5D			        pop ebp
 000000B5  C3			        ret
 000000B6			arrmerge ENDP

				END                             ; end of source code
