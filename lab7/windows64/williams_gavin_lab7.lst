 00000137  74 17		          je      gcd_done              ; if so, we are done

 00000139  BA 00000000		          mov     edx, 0                ; clear edx before div
 0000013E  F7 F3		          div     ebx                   ; eax = number1 / number2, edx = remainder
 00000140  89 15 0000000C R	          mov     remainder, edx        ; store remainder

